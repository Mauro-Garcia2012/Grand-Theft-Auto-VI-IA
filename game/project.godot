; Engine configuration file.
config_version=5

[application]

config/name="Vice City Stories VI - Free Roam"
config/description="Fan-made open world free roam inspired by GTA VI (Leonida / Vice City)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/autoload/game.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
common/max_physics_steps_per_frame=4
3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=3
environment/defaults/default_clear_color=Color(0.5, 0.7, 0.9, 1)

[shader_globals]

night_factor={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
